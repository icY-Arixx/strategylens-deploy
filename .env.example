# PowerShell: $env:STRATEGYLENS_DB = "data/strategylens.sqlite3"
# Optional. Relative paths resolve from the project root. No dotenv loader.
STRATEGYLENS_DB=data/strategylens.sqlite3
# Environment-variable names only. This file never contains real credentials.
STRATEGYLENS_PROVIDER=fuyao_validation
HITHINK_FINANCE_API_KEY=
# Required explicit report: YYYY-1 / YYYY-2 / YYYY-3 / YYYY-4.
FUYAO_REPORT=
# Conservative client pacing, not an assertion of an official QPS allowance.
FUYAO_MIN_INTERVAL=1.0
FUYAO_TIMEOUT=20

STRATEGYLENS_COMPILER=demo
STRATEGYLENS_LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
STRATEGYLENS_LLM_MODEL=Qwen/Qwen3-8B
